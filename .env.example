# ── Telegram API credentials ──────────────────────────────────────────────
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# ── LLM provider ─────────────────────────────────────────────────────────
# "openai" for any OpenAI-compatible API, "ollama" for local Ollama
LLM_PROVIDER=openai

# ── OpenAI-compatible settings ────────────────────────────────────────────
LLM_API_KEY=sk-your-key-here
# Uncomment and set for non-OpenAI providers (OpenRouter, LMStudio, etc.)
# LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gpt-4o-mini

# ── Ollama settings (only used when LLM_PROVIDER=ollama) ─────────────────
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# ── App settings ─────────────────────────────────────────────────────────
OUTPUT_FILE=classified_messages.json
BATCH_SIZE=10
# MAX_MESSAGES=100
